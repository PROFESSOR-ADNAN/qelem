# ==============================================================================
# QELEM ENVIRONMENT CONFIGURATION (SAMPLE / TEMPLATE)
# ==============================================================================

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:3000
BASE_DOMAIN=example.com

# Database (MongoDB Single-Node Replica Set rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/qelem?replicaSet=rs0&directConnection=true

# Valkey / Redis
REDIS_URL=redis://127.0.0.1:6379

# Cryptography & Security Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min_32_chars_123456
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars_123456
CURSOR_SIGNING_SECRET=dev_cursor_signing_secret_change_in_production_32_chars_123
CURSOR_SIGNING_SECRET_OLD=
UNSUBSCRIBE_TOKEN_SECRET=dev_unsubscribe_token_secret_min_32_chars_123456789

# Object Storage (S3 / Cloudflare R2 / MinIO in dev)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=qelem-dev-bucket
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_CDN_URL=http://localhost:9000/qelem-dev-bucket/media

# Email Provider (Mailpit in dev; Resend / Brevo in prod)
EMAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Qelem Community <noreply@example.com>"
EMAIL_DAILY_BUDGET=90

# Feature Flags & System Limits
FANOUT_MAX_FOLLOWERS=2000
FANOUT_HYSTERESIS_LOW=1600
FEED_MAX_ENTRIES=600
ACTIVE_WINDOW_DAYS=14
EMAIL_DIGEST_ENABLED=true
RATE_LIMIT_ENABLED=true
