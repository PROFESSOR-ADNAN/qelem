{
  "name": "@qelem/shared",
  "version": "1.0.0",
  "description": "Shared Zod schemas, types, and cursor utilities for Qelem",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cursors": {
      "types": "./dist/cursors.d.ts",
      "default": "./dist/cursors.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
